[Desktop Entry]
Type=Application
Name=File Manager
GenericName=Files
Comment=Browse and manage files
Exec=file-manager %U
Icon=dev.filemanager.FileManager
Terminal=false
Categories=GTK;System;FileTools;FileManager;
Keywords=files;folders;browse;explorer;directory;archive;
MimeType=inode/directory;
StartupNotify=true
StartupWMClass=dev.filemanager.FileManager
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=file-manager
