[Desktop Entry]
Type=Application
Name=Luma
GenericName=Files
Comment=Browse and manage files
Exec=luma %U
Icon=dev.ridom.Luma
Terminal=false
Categories=GTK;System;FileTools;FileManager;
Keywords=files;folders;browse;explorer;directory;archive;
MimeType=inode/directory;
StartupNotify=true
StartupWMClass=dev.ridom.Luma
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=luma
